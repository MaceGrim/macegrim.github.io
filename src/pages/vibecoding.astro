---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Vibe Coding 101 | Mason Grimshaw"
  description="Vibe Coding 101 presentation and resources."
>
  <section class="page-intro wrap">
    <span class="eyebrow reveal"><span class="tick">◆</span> Workshop</span>
    <h1 class="reveal">Vibe Coding <em>101.</em></h1>
    <p class="page-lead reveal">A short resource page for the Vibe Coding 101 deck.</p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(40px, 7vw, 80px);">
    <div class="card measure reveal">
      <h3>Download the slides</h3>
      <p style="margin-top:12px">Use the link below to download the PowerPoint presentation for Vibe Coding 101.</p>
      <p style="margin-top:20px">
        <a class="btn" href="/downloads/vibe-coding-101.pptx"><span>↓</span> vibe-coding-101.pptx</a>
      </p>
    </div>

    <div class="page-foot">
      <a class="back-link" href="/"><span>←</span> Back to home</a>
    </div>
  </section>
</BaseLayout>
