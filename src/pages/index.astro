---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Sorted by date descending. Lakota AI Code Camp (portfolio-3) carries the
// newest date to keep it first.
const projects = (await getCollection('portfolio')).sort(
  (a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime()
);

const pad = (n: number) => String(n).padStart(2, '0');
const isPeoplesVoice = (label: string) => label.toLowerCase().includes("people");
---

<BaseLayout title="Mason Grimshaw — AI Engineer, Educator, Builder">
  <!-- ===================== Hero ===================== -->
  <section class="hero wrap">
    <div class="hero-grid">
      <div>
        <span class="eyebrow reveal"><span class="tick">◆</span> <span data-ticker data-roles="AI Engineer|Educator|Builder|Sicangu Lakota|Dad to four" aria-label="AI Engineer, Educator, Builder">AI Engineer · Educator · Builder</span></span>
        <h1 class="display hero-name reveal">Mason<br /><em>Grimshaw</em></h1>
        <p class="hero-roles reveal">
          AI Engineer at <a class="proselink" href="https://ode.partners" target="_blank" rel="noopener">Ode Partners</a>.
          VP of <a class="proselink" href="https://www.indigigenius.org" target="_blank" rel="noopener">IndigiGenius</a>,
          co-founder of the <a class="proselink" href="https://www.indigigenius.org/lakota-ai-code-camp" target="_blank" rel="noopener">Lakota AI Code Camp</a>.
          <br /><strong>Sicangu Lakota. Husband. Dad to four.</strong>
        </p>
      </div>
      <figure class="portrait reveal">
        <img src="/images/profile.png" alt="Mason Grimshaw" loading="eager" />
        <figcaption>Rapid City · Black Hills</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== Manifesto ===================== -->
  <section class="manifesto">
    <div class="wrap manifesto-grid">
      <p class="lead reveal">
        I build AI tools for organizations and tribal nations, teach data science to Indigenous youth and practitioners, and have advised on AI policy at the federal level. Most of my time goes to figuring out <em>what a tool actually does for people</em> — and whether it should exist at all.
      </p>
    </div>
  </section>

  <!-- ===================== Projects ===================== -->
  <section class="section wrap" id="projects">
    <div class="section-head">
      <div>
        <div class="index reveal">PROJECTS / SELECTED WORK</div>
        <h2 class="section-title reveal">Things I've <em>helped build.</em></h2>
      </div>
      <p class="reveal">A mix of production tools, community platforms, and experiments — built mostly at Ode Partners and through IndigiGenius.</p>
    </div>

    <ul class="projects">
      {projects.map((project, i) => (
        <li>
          <a class="project reveal" href={project.data.demo_url ?? project.data.source_url ?? '#'} target="_blank" rel="noopener">
            <span class="num">{pad(i + 1)}</span>
            <div class="project-body">
              <h3>{project.data.title}</h3>
              {project.data.webby && (
                <div class="badges">
                  {project.data.webby.map((award) => (
                    <span class="badge">
                      {isPeoplesVoice(award.label) ? (
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.8.7-5.1 4.6 1.4 6.7L12 17.8 6 20.6l1.4-6.7L2.3 9l6.8-.7z"/></svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h12v3h3v3a4 4 0 0 1-4 4h-.6A5 5 0 0 1 13 16.9V19h3v3H8v-3h3v-2.1A5 5 0 0 1 7.6 12H7a4 4 0 0 1-4-4V5h3V2zm0 5H5v1a2 2 0 0 0 1 1.7V7zm12 0v2.7A2 2 0 0 0 19 8V7h-1z"/></svg>
                      )}
                      {award.label} <span class="yr">{award.year}</span>
                    </span>
                  ))}
                </div>
              )}
              <p>{project.data.description}</p>
              <span class="arrow">View project <span>→</span></span>
            </div>
            {project.data.image && (
              <span class={`project-thumb${project.data.image_fit === 'contain' ? ' contain' : ''}`}>
                <img src={project.data.image} alt={project.data.title} loading="lazy" />
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===================== Highlights ===================== -->
  <section class="highlights" id="highlights">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="index reveal">FEATURED / IN THE PRESS</div>
          <h2 class="section-title reveal"><em>Highlights.</em></h2>
        </div>
        <p class="reveal">Talks, press, and conversations on AI literacy, Indigenous data sovereignty, and building tools that serve communities.</p>
      </div>
    </div>

    <div class="mosaic-wrap">
      <div class="mosaic">
        <!-- TEDx feature video -->
        <a class="mtile media t-tedx reveal" href="https://www.youtube.com/watch?v=kRqjTGQ0qkU" target="_blank" rel="noopener" aria-label="Watch the TEDx Boston talk">
          <img src="https://i.ytimg.com/vi/kRqjTGQ0qkU/hqdefault.jpg" alt="TEDx Boston talk" loading="lazy" />
          <span class="m-play"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <div class="m-body">
            <div class="m-type">Talk · TEDx</div>
            <h3 class="m-title">Bringing AI from Silicon Valley to the Black Hills</h3>
            <div class="m-src">TEDx Boston · 2023</div>
          </div>
        </a>

        <!-- NYT -->
        <a class="mtile text t-nyt reveal" href="https://www.nytimes.com/2021/06/29/science/indigenous-data-microbiome-science.html" target="_blank" rel="noopener">
          <div>
            <span class="m-type">Press</span>
            <h3 class="m-title">Training the Next Generation of Indigenous Data Scientists</h3>
          </div>
          <div class="m-src">The New York Times · 2021 <span class="ext">↗</span></div>
        </a>

        <!-- Forbes -->
        <a class="mtile text t-forbes reveal" href="https://www.forbes.com/sites/johnwerner/2023/11/20/lakota-code-camp-bringing-it-to-native-communities/" target="_blank" rel="noopener">
          <div>
            <span class="m-type">Press</span>
            <h3 class="m-title">Lakota Code Camp: Native American Tech Leaders Bringing Native Youth Into AI Innovation</h3>
          </div>
          <div class="m-src">Forbes · 2023 <span class="ext">↗</span></div>
        </a>

        <!-- 40 Under 40 -->
        <div class="mtile media t-40 reveal">
          <img src="/images/featured/40u40-landscape.png" alt="Mason Grimshaw — Black Hills 40 Under 40" loading="lazy" />
          <div class="m-body">
            <div class="m-type">Recognition</div>
            <h3 class="m-title">Black Hills 40 Under 40</h3>
            <div class="m-src">Rapid City Business Journal · 2026</div>
          </div>
        </div>

        <!-- Elevate cover -->
        <a class="mtile media t-elevate reveal" href="https://issuu.com/elevaterapidcity/docs/elevate_rapid_city_magazine_october_2022_innovatio" target="_blank" rel="noopener" aria-label="Read the Elevate Magazine feature">
          <img src="/images/featured/elevate-cover.png" alt="Elevate Magazine — Innovation in the Black Hills" loading="lazy" />
          <div class="m-body">
            <div class="m-type">Feature · Elevate</div>
            <h3 class="m-title">Innovation in the Black Hills</h3>
            <div class="m-src">Elevate Rapid City · 2022</div>
          </div>
        </a>

        <!-- Teen Vogue -->
        <a class="mtile text t-tv reveal" href="https://www.teenvogue.com/story/these-coding-camps-are-teaching-indigenous-youth-to-save-native-language-through-ai" target="_blank" rel="noopener">
          <div>
            <span class="m-type">Press</span>
            <h3 class="m-title">Indigenous Youth Are Using AI to Save Native Language</h3>
          </div>
          <div class="m-src">Teen Vogue · 2024 <span class="ext">↗</span></div>
        </a>

        <!-- Pritzker award -->
        <a class="mtile text t-pritz reveal" href="https://www.ioes.ucla.edu/person/mason-grimshaw/" target="_blank" rel="noopener">
          <div>
            <span class="m-type">Award</span>
            <h3 class="m-title">Pritzker Environmental Genius Award — Nominee</h3>
          </div>
          <div class="m-src">UCLA IoES · 2025 <span class="ext">↗</span></div>
        </a>

        <!-- Axios video -->
        <a class="mtile media t-axios reveal" href="https://www.youtube.com/watch?v=K2nAQktoMng" target="_blank" rel="noopener" aria-label="Watch the Axios +AI Summit">
          <img src="https://i.ytimg.com/vi/K2nAQktoMng/hqdefault.jpg" alt="Axios +AI Summit" loading="lazy" />
          <span class="m-play"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <div class="m-body">
            <div class="m-type">Talk · Axios</div>
            <h3 class="m-title">Axios +AI Summit</h3>
            <div class="m-src">Axios · 2024</div>
          </div>
        </a>

        <!-- NBC video -->
        <a class="mtile media t-nbc reveal" href="https://www.youtube.com/watch?v=RDAa8WbuZaU" target="_blank" rel="noopener" aria-label="Watch the NBC News feature">
          <img src="https://i.ytimg.com/vi/RDAa8WbuZaU/hqdefault.jpg" alt="NBC News feature" loading="lazy" />
          <span class="m-play"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <div class="m-body">
            <div class="m-type">Press · NBC News</div>
            <h3 class="m-title">AI Camp Teaches Native Teens to Preserve Lakota Culture</h3>
            <div class="m-src">NBC News</div>
          </div>
        </a>

        <!-- Podcast — playable embed -->
        <div class="mtile embed t-pod reveal">
          <iframe
            src="https://share.transistor.fm/e/1231e2ef"
            width="100%"
            height="100%"
            frameborder="0"
            scrolling="no"
            seamless
            loading="lazy"
            title="AI Literacy & Data Sovereignty for Indigenous Communities — In AI We Trust? (EqualAI)"
          ></iframe>
        </div>

        <!-- NAIAC briefing -->
        <a class="mtile text t-naiac reveal" href="https://data.aclum.org/wp-content/uploads/2025/01/NAIAC_ai_gov_wp-content_uploads_2023_12_Findings_Exploring-the-Impact-of-AI.pdf" target="_blank" rel="noopener">
          <div>
            <span class="m-type">Briefing · The White House</span>
            <h3 class="m-title">Findings: Exploring the Impact of AI</h3>
          </div>
          <div class="m-src">Nat'l AI Advisory Committee · 2023 <span class="ext">↗</span></div>
        </a>
      </div>

      <a class="view-all" href="/talks">View all talks <span>→</span></a>
    </div>
  </section>
</BaseLayout>
