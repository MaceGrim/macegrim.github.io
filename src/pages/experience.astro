---

<BaseLayout title="Experience | Mason Grimshaw">
  <section class="page-intro wrap">
    <span class="eyebrow reveal"><span class="tick">◆</span> Background</span>
    <h1 class="reveal"><em>Experience.</em></h1>
    <p class="page-lead reveal">
      I went to MIT, grew up on the Rosebud Reservation, and have spent the last eight years turning data into tools that actually help people — from optimizing transit routes in Boston to teaching AI to Lakota youth.
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(40px, 7vw, 80px);">
    <h2 class="subhead reveal"><em>Education.</em></h2>
    <div class="cards">
      {education.map((c) => (
        <div class="card reveal">
          <div class="card-head">
            <div>
              <h3>{c.org}</h3>
              <p class="card-role">{c.role}</p>
              {c.place && <p class="card-place">{c.place}</p>}
            </div>
            <span class="card-when">{c.when}</span>
          </div>
          <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </div>

    <h2 class="subhead reveal"><em>Work.</em></h2>
    <div class="cards">
      {work.map((c) => (
        <div class="card reveal">
          <div class="card-head">
            <div>
              <h3>{c.org}</h3>
              <p class="card-role">{c.role}</p>
              {c.place && <p class="card-place">{c.place}</p>}
            </div>
            <span class="card-when">{c.when}</span>
          </div>
          <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </div>

    <div class="page-foot">
      <a class="back-link" href="/"><span>←</span> Back to home</a>
    </div>
  </section>
</BaseLayout>
