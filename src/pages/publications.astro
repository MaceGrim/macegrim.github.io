---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = (await getCollection('publications')).sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout title="Publications | Mason Grimshaw">
  <section class="page-intro wrap">
    <span class="eyebrow reveal"><span class="tick">◆</span> Research</span>
    <h1 class="reveal"><em>Publications.</em></h1>
  </section>

  <section class="wrap" style="padding-bottom: clamp(40px, 7vw, 80px);">
    <ul class="entry-list">
      {publications.map((pub) => {
        const Tag = pub.data.paperurl ? 'a' : 'div';
        return (
          <li>
            <Tag
              class="entry reveal"
              {...(pub.data.paperurl ? { href: pub.data.paperurl, target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="entry-date">{pub.data.date ? fmt(pub.data.date) : ''}</span>
              <div class="entry-main">
                <h2>{pub.data.title}</h2>
                {pub.data.excerpt && <p>{pub.data.excerpt}</p>}
              </div>
              <span class="entry-meta">
                {pub.data.venue && <span class="type">{pub.data.venue}</span>}
                {pub.data.paperurl && <span> ↗</span>}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>

    <div class="page-foot">
      <a class="back-link" href="/"><span>←</span> Back to home</a>
    </div>
  </section>
</BaseLayout>
