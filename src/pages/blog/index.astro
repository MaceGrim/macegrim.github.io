---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const [featured, ...rest] = posts;
---

<BaseLayout title="Blog | Mason Grimshaw">
  <section class="blog-masthead wrap">
    <div class="index reveal">WRITING / NOTES</div>
    <h1 class="reveal">Thinking <em>out loud.</em></h1>
    <p class="reveal">Notes on building AI systems, teaching data science, and the occasional experiment that got out of hand.</p>
  </section>

  <div class="wrap" style="padding-bottom: clamp(40px, 7vw, 80px);">
    {featured && (
      <a class="featured no-thumb reveal" href={`/blog/${featured.id}`}>
        <div class="feat-body">
          <div class="feat-kicker">
            {featured.data.category && <span>{featured.data.category}</span>}
            {featured.data.category && featured.data.date && <span class="dot">·</span>}
            {featured.data.date && <span>{fmt(featured.data.date)}</span>}
          </div>
          <h2>{featured.data.title}</h2>
          {(featured.data.description || featured.data.excerpt) && (
            <p class="feat-excerpt">{featured.data.description ?? featured.data.excerpt}</p>
          )}
          <span class="arrow">Read <span>→</span></span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <ul class="post-list">
        {rest.map((post) => (
          <li>
            <a class="post-row reveal" href={`/blog/${post.id}`}>
              <span class="post-date">{post.data.date ? fmt(post.data.date) : ''}</span>
              <div class="post-main">
                <h3>{post.data.title}</h3>
                {(post.data.description || post.data.excerpt) && (
                  <p>{post.data.description ?? post.data.excerpt}</p>
                )}
                {post.data.tags && (
                  <div class="post-tags">
                    {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </div>
              <span class="post-meta">{post.data.category}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="page-foot">
      <a class="back-link" href="/"><span>←</span> Back to home</a>
    </div>
  </div>
</BaseLayout>
