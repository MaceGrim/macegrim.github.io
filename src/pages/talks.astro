---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const talks = (await getCollection('talks')).sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<BaseLayout title="Talks | Mason Grimshaw">
  <section class="page-intro wrap">
    <span class="eyebrow reveal"><span class="tick">◆</span> Speaking</span>
    <h1 class="reveal">Talks &amp; <em>panels.</em></h1>
    <p class="page-lead reveal">
      I talk about building AI tools for the people who need them, teaching data science to Indigenous youth, and why the people closest to a problem should be the ones building the tools — TEDx, NeurIPS, Axios, and a lot of classrooms in between.
    </p>
  </section>

  <section class="wrap" style="padding-bottom: clamp(40px, 7vw, 80px);">
    <ul class="entry-list">
      {talks.map((talk) => {
        const Tag = talk.data.url ? 'a' : 'div';
        return (
          <li>
            <Tag
              class="entry reveal"
              {...(talk.data.url ? { href: talk.data.url, target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="entry-date">{talk.data.date ? fmt(talk.data.date) : ''}</span>
              <div class="entry-main">
                <h2>{talk.data.title}</h2>
                {(talk.data.venue || talk.data.location) && (
                  <p>
                    {talk.data.venue}{talk.data.venue && talk.data.location ? ' · ' : ''}{talk.data.location}
                  </p>
                )}
              </div>
              <span class="entry-meta">
                {talk.data.type && <span class="type">{talk.data.type}</span>}
                {talk.data.url && <span> ↗</span>}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>

    <div class="page-foot">
      <a class="back-link" href="/"><span>←</span> Back to home</a>
    </div>
  </section>
</BaseLayout>
